DATABASE_URL="postgresql://user:password@localhost:5432/abyssinia_jobs"

# Telegram bot token — used to validate Mini App initData signatures
# (src/lib/telegram/validate.ts). Get it from @BotFather. This is the only auth credential.
TELEGRAM_BOT_TOKEN=""

# Secret used to sign session JWTs (src/lib/auth.ts). Use a long random string in production.
SESSION_SECRET="change-me-to-a-long-random-string"

# Comma-separated Telegram user ids allowed into the admin verification queue (/admin).
ADMIN_TELEGRAM_IDS=""

# Optional media storage — leave unset to store uploads inline as base64 data
# URLs in Postgres (works out of the box, 4MB per file cap; src/lib/upload.ts).
# AWS_S3_BUCKET=""
# AWS_S3_REGION=""
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# CLOUDINARY_URL=""
