generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  SEEKER
  RECRUITER
}

// PENDING_APPROVAL: signed up, documents under admin review — locked out of the feed.
// APPROVED: admin verified documents — full access to swipe decks.
// REJECTED: admin rejected documents — locked out, shown a rejection screen.
enum AccountStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum SwipeAction {
  LIKE
  PASS
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
}

enum WorkMode {
  REMOTE
  ON_SITE
  HYBRID
}

model Account {
  id            String        @id @default(cuid())

  // Telegram is the sole identity/auth source. `telegramId` is populated from
  // validated initData (see src/lib/telegram/validate.ts) — no passwords are
  // ever stored. `username` drives the direct chat deep-link on a match.
  telegramId    String        @unique
  username      String?
  status        AccountStatus @default(PENDING_APPROVAL)

  role          Role
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  seekerProfile   SeekerProfile?
  companyProfile  CompanyProfile?

  swipesGiven     Swipe[]  @relation("SwipeActor")
  matchesAsSeeker Match[]  @relation("MatchSeeker")
  matchesAsRecruiter Match[] @relation("MatchRecruiter")
  ratingsGiven    CompanyRating[] @relation("RatingSeeker")
  ratingsReceived CompanyRating[] @relation("RatingCompany")

  @@index([role])
  @@index([status])
}

model SeekerProfile {
  id          String   @id @default(cuid())
  accountId   String   @unique
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  // Required at signup, optional below: the documents step (Step 3 of onboarding)
  // creates this row with just fullName + the government ID; the rest is filled
  // in by a later "complete your profile" step before the seeker can be approved.
  fullName    String
  headline    String?
  yearsExp    Int      @default(0)
  bio         String?

  // Verification gate document — required before an admin can approve the account.
  governmentIdUrl   String?

  // Dual-slide swipe card media: slide 1 is the photo, slide 2 is the pitch video.
  // videoPitchUrl is an external YouTube/TikTok link, embedded via iframe —
  // never an uploaded file, so there's no video hosting cost.
  profilePhotoUrl   String?
  videoPitchUrl     String?

  skills            String[]
  skillsDescription String?  // crisp overlay text shown on the card ("primary skill arrays")
  avatarUrl         String?
  location          String?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model CompanyProfile {
  id          String   @id @default(cuid())
  accountId   String   @unique
  account     Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)

  companyName String
  logoUrl     String?
  about       String?
  location    String?

  // Verification gate documents — both required before an admin can approve the account.
  commercialLicenseUrl String?
  ownerIdUrl            String?

  jobs        Job[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// 1-10 star rating (half-steps allowed, e.g. 7.5) that a seeker leaves for a company
// after matching. One rating per seeker/company pair; the company's running average
// is computed on read from this table rather than stored redundantly.
model CompanyRating {
  id          String   @id @default(cuid())

  seekerId    String
  seeker      Account  @relation("RatingSeeker", fields: [seekerId], references: [id], onDelete: Cascade)

  companyId   String
  company     Account  @relation("RatingCompany", fields: [companyId], references: [id], onDelete: Cascade)

  // Enforced in the API layer (1.0-10.0 in 0.5 steps); Postgres CHECK constraints
  // aren't expressible in the Prisma schema DSL, so add one in a migration:
  //   ALTER TABLE "CompanyRating" ADD CONSTRAINT rating_range CHECK (rating >= 1 AND rating <= 10);
  rating      Float

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([seekerId, companyId])
  @@index([companyId])
}

model Job {
  id            String      @id @default(cuid())
  companyId     String
  company       CompanyProfile @relation(fields: [companyId], references: [id], onDelete: Cascade)

  title         String
  description   String
  tags          String[]
  jobType       JobType
  workMode      WorkMode
  salaryMin     Int?
  salaryMax     Int?
  salaryPeriod  String      @default("MONTHLY") // MONTHLY | YEARLY
  currency      String      @default("ETB")

  isActive      Boolean     @default(true)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  swipes        Swipe[]
  matches       Match[]

  @@index([isActive])
}

// A swipe always belongs to an Account (the actor) acting on a Job.
// Seeker swipe: actor = seeker, jobId = the job, targetAccountId = null.
// Recruiter swipe: actor = recruiter, jobId = the opening, targetAccountId = candidate's accountId.
// `subjectKey` is a derived, never-null dedupe key (jobId, or "jobId:targetAccountId")
// because Postgres treats NULLs as distinct in unique indexes and a nullable
// targetAccountId would otherwise let duplicate seeker swipes slip through.
model Swipe {
  id              String      @id @default(cuid())
  actorId         String
  actor           Account     @relation("SwipeActor", fields: [actorId], references: [id], onDelete: Cascade)

  jobId           String
  job             Job         @relation(fields: [jobId], references: [id], onDelete: Cascade)

  targetAccountId String?     // candidate's accountId, set only for recruiter swipes
  subjectKey      String

  action          SwipeAction
  createdAt       DateTime    @default(now())

  @@unique([actorId, subjectKey])
  @@index([jobId])
  @@index([targetAccountId])
}

model Match {
  id              String   @id @default(cuid())

  seekerId        String
  seeker          Account  @relation("MatchSeeker", fields: [seekerId], references: [id], onDelete: Cascade)

  recruiterId     String
  recruiter       Account  @relation("MatchRecruiter", fields: [recruiterId], references: [id], onDelete: Cascade)

  jobId           String
  job             Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  createdAt       DateTime @default(now())

  @@unique([seekerId, jobId])
  @@index([recruiterId])
}
